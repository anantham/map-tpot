# API Backend URL
# For local development:
VITE_API_URL=http://localhost:5001

# For production (set this in Vercel dashboard):
# VITE_API_URL=https://tpot-analyzer-api.fly.dev

# Curator token for mutating endpoints. Must match TPOT_CURATOR_TOKEN on the
# server. Generate locally with: openssl rand -hex 32 (or any random string).
# WARNING: this token is bundled into the client. Never deploy this UI
# publicly without an additional reverse-proxy auth layer.
VITE_TPOT_CURATOR_TOKEN=
